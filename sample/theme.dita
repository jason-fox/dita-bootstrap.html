        <div outputclass="p-3 theme-secondary theme-contrast">Theme Secondary with a
          <xref outputclass="underline-50 hover:underline-100" href="#">nested link</xref> inside.</div>
      </div>
    </example>
    <codeblock>&lt;div outputclass="p-3 theme-primary theme-contrast"&gt;Theme Primary with a
  &lt;xref outputclass="underline-50 hover:underline-100" href="#"&gt;nested link&lt;/xref&gt; inside.&lt;/div&gt;</codeblock>

    <section id="subtle">
      <title>Subtle</title>
