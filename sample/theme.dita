        <div outputclass="p-2 theme-secondary theme-muted">.theme-secondary .theme-muted</div>
      </div>
    </example>
    <codeblock>&lt;div outputclass="p-2 theme-primary theme-muted"&gt;.theme-primary .theme-muted&lt;/div&gt;
&lt;div outputclass="p-2 theme-accent theme-muted"&gt;.theme-accent .theme-muted&lt;/div&gt;
