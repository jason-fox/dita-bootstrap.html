        <div outputclass="p-2 theme-warning theme-subtle">.theme-warning .theme-subtle</div>
        <div outputclass="p-2 theme-info theme-subtle">.theme-info .theme-subtle</div>
        <div outputclass="p-2 theme-inverse theme-subtle">.theme-inverse .theme-subtle</div>
        <div outputclass="p-2 theme-secondary theme-subtle">.theme-secondary .theme-subtle</div>
      </div>
    </example>
    <codeblock>&lt;div outputclass="p-2 theme-primary theme-subtle"&gt;.theme-primary .theme-subtle&lt;/div&gt;
&lt;div outputclass="p-2 theme-accent theme-subtle"&gt;.theme-accent .theme-subtle&lt;/div&gt;
&lt;div outputclass="p-2 theme-success theme-subtle"&gt;.theme-success .theme-subtle&lt;/div&gt;
&lt;div outputclass="p-2 theme-danger theme-subtle"&gt;.theme-danger .theme-subtle&lt;/div&gt;
&lt;div outputclass="p-2 theme-warning theme-subtle"&gt;.theme-warning .theme-subtle&lt;/div&gt;
